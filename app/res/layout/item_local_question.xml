<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:defaultFocusHighlightEnabled="false"
    android:elevation="0dp"
    android:foreground="@android:color/transparent"
    android:orientation="vertical"
    android:stateListAnimator="@null">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_15"
        android:layout_marginRight="@dimen/margin_10"
        android:orientation="vertical">

        <TextView
            android:id="@+id/local_question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_common" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/local_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:defaultFocusHighlightEnabled="false"
        android:elevation="0dp"
        android:foreground="@android:color/transparent"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:orientation="vertical"
        android:stateListAnimator="@null">

        <RadioButton
            android:id="@+id/local_opt_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:button="@drawable/radio_bg_a"
            android:defaultFocusHighlightEnabled="false"
            android:elevation="0dp"
            android:foreground="@android:color/transparent"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:minHeight="@dimen/radio_height"
            android:padding="@dimen/radio_padding"
            android:stateListAnimator="@null"
            android:textColor="@color/text_common"
            android:textSize="@dimen/text_common" />

        <RadioButton
            android:id="@+id/local_opt_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:button="@drawable/radio_bg_b"
            android:defaultFocusHighlightEnabled="false"
            android:elevation="0dp"
            android:foreground="@android:color/transparent"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:minHeight="@dimen/radio_height"
            android:padding="@dimen/radio_padding"
            android:stateListAnimator="@null"
            android:textColor="@color/text_common"
            android:textSize="@dimen/text_common" />

        <RadioButton
            android:id="@+id/local_opt_c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:button="@drawable/radio_bg_c"
            android:defaultFocusHighlightEnabled="false"
            android:elevation="0dp"
            android:foreground="@android:color/transparent"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:minHeight="@dimen/radio_height"
            android:padding="@dimen/radio_padding"
            android:stateListAnimator="@null"
            android:textColor="@color/text_common"
            android:textSize="@dimen/text_common" />
    </RadioGroup>

    <RelativeLayout
        android:id="@+id/local_result_row"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/local_answer_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/margin_10"
            android:gravity="center_vertical"
            android:text="正确答案"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/local_answer_value"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/margin_15"
            android:layout_toRightOf="@id/local_answer_title"
            android:gravity="center_vertical"
            android:textColor="@color/result_blue"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/local_transcript_link"
            android:layout_width="80dp"
            android:layout_height="58dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/btn_press_bg"
            android:gravity="center"
            android:text="原文"
            android:textColor="@color/result_blue"
            android:textSize="@dimen/text_common" />
    </RelativeLayout>

    <TextView
        android:id="@+id/local_transcript_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_5"
        android:layout_marginRight="@dimen/margin_10"
        android:background="@drawable/transcript_bg"
        android:lineSpacingMultiplier="1.4"
        android:padding="@dimen/margin_10"
        android:textColor="@color/content_text"
        android:textSize="@dimen/text_common"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_1"
        android:layout_marginTop="@dimen/margin_10"
        android:background="@color/line_grey" />
</LinearLayout>
