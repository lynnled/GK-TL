<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/topbar_height"
    android:background="@color/white">

    <ImageView
        android:id="@+id/local_back"
        android:layout_width="@dimen/topbar_height"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:background="@drawable/btn_press_bg"
        android:scaleType="center"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/local_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/margin_5"
        android:layout_toLeftOf="@+id/local_submit"
        android:layout_toRightOf="@id/local_back"
        android:ellipsize="end"
        android:maxLength="50"
        android:singleLine="true"
        android:textColor="@color/text_black"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/local_submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/margin_5"
        android:background="@drawable/topbar_btn_bg"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:text="提交答案"
        android:textColor="@color/topbar_btn_text"
        android:textSize="@dimen/text_common" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_1"
        android:layout_alignParentBottom="true"
        android:background="@color/line_grey" />
</RelativeLayout>
